{
  "name": "nivel-ui",
  "homepage": "https://rcastillejo.github.io/nivel-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "export": "next build",
    "predeploy": "npm run export",
    "deploy": "gh-pages -d out",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:integration": "vitest --project integration",
    "typecheck": "tsc --noEmit",
    "validate": "npm run test:run && npm run typecheck && npm run lint",
    "validate:full": "npm run validate && npm run build",
    "precommit": "npm run validate",
    "prepush": "npm run validate:full",
    "prepare": "husky"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "next": "16.1.3",
    "react": "19.2.3",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.3",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.1.1"
  }
}
