# nivel-ui — Variables de entorno requeridas
# Copiar como .env.local y completar con valores reales.
# NUNCA commitear .env.local con valores reales.

# ---------------------------------------------------------------
# Supabase (requerido para persistencia compartida en producción)
# Obtener en: Supabase Dashboard → Settings → API
# Sin estas variables la app usa LocalStorage como fallback.
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ---------------------------------------------------------------
# Sentry (opcional — error tracking)
# Obtener en: sentry.io → Project → Settings → Client Keys (DSN)
# Sin esta variable Sentry está desactivado (no lanza errores).
# ---------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>

# Solo necesario si quieres subir source maps a Sentry en CI/CD
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=tu-org
# SENTRY_PROJECT=nivel-ui

# ---------------------------------------------------------------
# Google OAuth (requerido para el botón "Continuar con Google")
# No se necesitan variables extra aquí: la URL de callback se
# genera automáticamente desde window.location.origin.
#
# Pasos de configuración:
# 1. Google Cloud Console → APIs & Services → Credentials →
#    "Create OAuth 2.0 Client ID" (tipo: Web application)
#    Authorized redirect URI: https://<tu-dominio>/auth/callback
# 2. Supabase Dashboard → Authentication → Providers → Google →
#    pegar Client ID y Client Secret de Google Cloud.
# 3. Para desarrollo local añadir también:
#    http://localhost:3000/auth/callback
# ---------------------------------------------------------------
